<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- IHttpContextAccessor, for the actor accessor. Same mechanism Venly.Backend.Common uses. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.6.1" />
    <PackageReference Include="MediatR" Version="12.5.0" />
    <!-- Microsoft.Extensions.Hosting.Abstractions and .Options.ConfigurationExtensions were referenced here
         explicitly and are NOT needed: both come in with the shared framework, and NuGet says so with NU1510
         ("will not be pruned ... does not need to be referenced explicitly"). Removed rather than left as
         noise on every restore of every service that references this project. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Venly.Backend.Common\Venly.Backend.Common.csproj" />
    <ProjectReference Include="..\Venly.Messaging.Events\Venly.Messaging.Events.csproj" />
  </ItemGroup>

</Project>
